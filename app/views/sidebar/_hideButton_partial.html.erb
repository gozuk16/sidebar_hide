<% if sidebar_content? %>
  <% hidden = cookies['sidebarCookie'] == 'hide' %>
  <div id="sidebarHandler">
    <div id="hideSidebarButton" class="<%= hidden ? 'hide' : 'show' %>" role="button" tabindex="0"
         onclick="hideSideBar()" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); hideSideBar(); }"></div>
  </div>
  <% if hidden %>
    <%= javascript_tag 'sidebarHideApply(true);' %>
  <% end %>
<% end %>
